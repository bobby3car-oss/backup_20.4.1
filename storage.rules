rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isPatientOwner(patientId) {
      return isSignedIn() && uid() == patientId;
    }

    function linkDocPath(patientId, linkedUid, linkType) {
      return /databases/(default)/documents/patients/$(patientId)/links/$(linkedUid + '_' + linkType);
    }

    function hasActiveLink(patientId, linkType) {
      return firestore.exists(linkDocPath(patientId, uid(), linkType))
        && firestore.get(linkDocPath(patientId, uid(), linkType)).data.status == 'active'
        && firestore.get(linkDocPath(patientId, uid(), linkType)).data.linkedUid == uid();
    }

    function linkedReadAllowed(patientId, assetType) {
      return (hasActiveLink(patientId, 'doctor')
        && (
          // New model: featurePermissions present AND assetType mapped → use it
          ('featurePermissions' in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data
            && assetType in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions
            && firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions[assetType] in ['read', 'readWrite'])
          // Unmapped asset type (e.g. voice_memos, photos) or no featurePermissions
          // → fall back to binary read permission
          || (!('featurePermissions' in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data)
            || !(assetType in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions))
            && firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.permissions.read == true
        ))
      || (hasActiveLink(patientId, 'caregiver')
        && firestore.get(linkDocPath(patientId, uid(), 'caregiver')).data.permissions.read == true)
      || (hasActiveLink(patientId, 'family')
        && firestore.get(linkDocPath(patientId, uid(), 'family')).data.permissions.read == true
        && (
          !('visibility' in firestore.get(linkDocPath(patientId, uid(), 'family')).data)
          || firestore.get(linkDocPath(patientId, uid(), 'family')).data.visibility[assetType] == true
        ));
    }

    function linkedWriteAllowed(patientId, assetType) {
      return (hasActiveLink(patientId, 'doctor')
        && (
          // New model: featurePermissions present AND assetType mapped → use it
          ('featurePermissions' in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data
            && assetType in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions
            && firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions[assetType] == 'readWrite')
          // Unmapped asset type (e.g. voice_memos, photos) or no featurePermissions
          // → fall back to binary write permission
          || (!('featurePermissions' in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data)
            || !(assetType in firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions))
            && firestore.get(linkDocPath(patientId, uid(), 'doctor')).data.permissions.write == true
        ))
      || (hasActiveLink(patientId, 'caregiver')
        && firestore.get(linkDocPath(patientId, uid(), 'caregiver')).data.permissions.write == true)
      || (hasActiveLink(patientId, 'family')
        && firestore.get(linkDocPath(patientId, uid(), 'family')).data.permissions.write == true
        && (
          !('visibility' in firestore.get(linkDocPath(patientId, uid(), 'family')).data)
          || firestore.get(linkDocPath(patientId, uid(), 'family')).data.visibility[assetType] == true
        ));
    }

    function canReadPatientAssets(patientId, assetType) {
      return isAdmin()
        || isPatientOwner(patientId)
        || (isSignedIn() && linkedReadAllowed(patientId, assetType));
    }

    function canWritePatientAssets(patientId, assetType) {
      return isAdmin()
        || isPatientOwner(patientId)
        || (isSignedIn() && linkedWriteAllowed(patientId, assetType));
    }

    function isSupportedAssetType(assetType) {
      return assetType == 'wounds'
        || assetType == 'documents'
        || assetType == 'voice_memos'
        || assetType == 'photos'
        || assetType == 'observations';
    }

    // ── Upload safety: size & content-type limits ─────────────────
    function isWithinSizeLimit() {
      return request.resource.size < 50 * 1024 * 1024; // 50 MB
    }

    function isAllowedPatientContentType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('audio/(m4a|mp4|mpeg|aac)')
        || request.resource.contentType.matches('video/mp4');
    }

    function isAllowedImageContentType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    match /patients/{patientId}/{assetType}/{filePath=**} {
      allow read: if isSupportedAssetType(assetType) && canReadPatientAssets(patientId, assetType);
      allow write: if isSupportedAssetType(assetType) && canWritePatientAssets(patientId, assetType)
        && isWithinSizeLimit() && isAllowedPatientContentType();
    }

    // ── Wound analysis uploads (App Check enforced) ─────────────
    match /woundAnalysis/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if isSignedIn() && uid() == userId
        && isWithinSizeLimit() && isAllowedImageContentType();
    }

    // ── Ads assets (partner ad images) ────────────────────────────
    match /ads/{adPath=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && isWithinSizeLimit() && isAllowedImageContentType();
    }
  }
}
