{
  "name": "firestore-rules-tests",
  "private": true,
  "scripts": {
    "test": "mocha --timeout 30000 --exit admin_rules.test.js",
    "test:doctor": "mocha --timeout 30000 --exit doctor_access.test.js",
    "test:all": "mocha --timeout 30000 --exit admin_rules.test.js doctor_access.test.js",
