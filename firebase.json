{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "operationsbegleiter-860e7",
          "appId": "1:877420872558:android:d63c27afb8dbb4af1c777f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "operationsbegleiter-860e7",
          "appId": "1:877420872558:ios:e547608a1fd60a1f1c777f",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "operationsbegleiter-860e7",
          "configurations": {
            "android": "1:877420872558:android:d63c27afb8dbb4af1c777f",
            "ios": "1:877420872558:ios:e547608a1fd60a1f1c777f",
            "web": "1:877420872558:web:5b51372f926901471c777f"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-XSS-Protection", "value": "1; mode=block" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/doctor-invite/**",
        "destination": "/link.html"
      },
      {
        "source": "/doctor-link/**",
        "destination": "/link.html"
      },
      {
        "source": "/invite/**",
        "destination": "/link.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  }
}