# Auto-sync: ensure Manifest.lock always matches Podfile.lock after install.
install! 'cocoapods', :warn_for_unused_master_specs_repo => false

# Uncomment this line to define a global platform for your project
platform :ios, '15.6'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # Suppress all warnings from third-party Pods in the Xcode issue navigator.
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Ensure all pods use the same deployment target as the app.
      # Mismatched minos values trigger App Store validation errors for
      # embedded frameworks (e.g. objective_c.framework).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.6'

      # Suppress Swift 6 strict-concurrency warnings/errors in Pods.
      # Many third-party pods are not yet updated for Swift 6, which
      # causes thousands of issues in Xcode 17+.
      config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
    end
  end
end

# ── Auto-sync: never fail on "sandbox is not in sync with the Podfile.lock" ──
# Runs AFTER integration so the [CP] Check Pods Manifest.lock phases exist.
# Replaces the error script with one that copies Podfile.lock → Manifest.lock.
post_integrate do |installer|
  auto_sync_script = <<~'SCRIPT'
    if ! diff "${PODS_PODFILE_DIR_PATH}/Podfile.lock" "${PODS_ROOT}/Manifest.lock" > /dev/null 2>&1 ; then
      echo "warning: Pods out of sync – copying Podfile.lock → Manifest.lock" >&2
      cp "${PODS_PODFILE_DIR_PATH}/Podfile.lock" "${PODS_ROOT}/Manifest.lock"
    fi
    echo "SUCCESS" > "${SCRIPT_OUTPUT_FILE_0}"
  SCRIPT

  # Fix: objective_c native asset ships with simulator build metadata and no
  # dSYM in some Flutter/Xcode archive flows. Normalize the embedded iOS
  # framework after all framework embed phases and emit a matching dSYM so
  # App Store validation can accept the archive.
  native_asset_fix_script = <<~'SCRIPT'
    set -euo pipefail

    if [[ "${PLATFORM_NAME:-}" != "iphoneos" ]]; then
      exit 0
    fi

    APP_FRAMEWORKS="${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}"
    FRAMEWORK_DIR="${APP_FRAMEWORKS}/objective_c.framework"
    FRAMEWORK_BIN="${FRAMEWORK_DIR}/objective_c"
    FRAMEWORK_PLIST="${FRAMEWORK_DIR}/Info.plist"

    if [[ ! -f "$FRAMEWORK_BIN" ]]; then
      exit 0
    fi

    echo "Normalizing objective_c.framework for archive upload"
    TMP_BIN="$(mktemp "${TMPDIR:-/tmp}/objective_c.XXXXXX")"
    xcrun vtool -set-build-version ios "${IPHONEOS_DEPLOYMENT_TARGET}" "${IPHONEOS_DEPLOYMENT_TARGET}" -replace -output "$TMP_BIN" "$FRAMEWORK_BIN"
    mv "$TMP_BIN" "$FRAMEWORK_BIN"

    if [[ -f "$FRAMEWORK_PLIST" ]]; then
      /usr/libexec/PlistBuddy -c "Set :MinimumOSVersion ${IPHONEOS_DEPLOYMENT_TARGET}" "$FRAMEWORK_PLIST" \
        || /usr/libexec/PlistBuddy -c "Add :MinimumOSVersion string ${IPHONEOS_DEPLOYMENT_TARGET}" "$FRAMEWORK_PLIST"
    fi

    if [[ -n "${DWARF_DSYM_FOLDER_PATH:-}" && -d "${DWARF_DSYM_FOLDER_PATH}" ]]; then
      FRAMEWORK_DSYM="${DWARF_DSYM_FOLDER_PATH}/objective_c.framework.dSYM"
      rm -rf "$FRAMEWORK_DSYM"
      xcrun dsymutil "$FRAMEWORK_BIN" -o "$FRAMEWORK_DSYM" >/dev/null || true
    fi

    if [[ -n "${EXPANDED_CODE_SIGN_IDENTITY:-}" ]]; then
      /usr/bin/codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY}" --preserve-metadata=identifier,entitlements,flags --timestamp=none "$FRAMEWORK_DIR"
    fi
  SCRIPT

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.targets.each do |target|
      next unless target.name == 'Runner'

      # 1. Auto-sync manifest patch
      target.shell_script_build_phases.each do |phase|
        if phase.name == '[CP] Check Pods Manifest.lock'
          phase.shell_script = auto_sync_script
        end
      end

      # 2. Native asset fix – keep the phase updated and place it after the
      #    last framework embedding step so the archived binary and dSYM match.
      phase = target.shell_script_build_phases.find { |p| p.name == '[Flutter] Fix native asset platform' }
      unless phase
        phase = target.project.new(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
        phase.name = '[Flutter] Fix native asset platform'
      end
      phase.shell_path = '/bin/bash'
      phase.shell_script = native_asset_fix_script
      phase.run_only_for_deployment_postprocessing = '0'

      target.build_phases.delete(phase)
      embed_index = target.build_phases.index { |p| p.respond_to?(:name) && p.name == '[CP] Embed Pods Frameworks' }
      if embed_index
        target.build_phases.insert(embed_index + 1, phase)
      else
        target.build_phases << phase
      end
    end
    aggregate_target.user_project.save
  end
end
