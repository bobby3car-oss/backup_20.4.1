rules_version = '2';
// v2025-07-15: RLS audit — added missing rules for 21 collections
// v2025-07-14: staff aftercare, linkedReadAllowed, isStaffWithLink
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isPatientOwner(patientId) {
      return isSignedIn() && uid() == patientId;
    }

    // Convention for deterministic link ids:
    //   {linkedUid}_{linkType}
    function linkDocPath(patientId, linkedUid, linkType) {
      return /databases/$(database)/documents/patients/$(patientId)/links/$(linkedUid + '_' + linkType);
    }

    function hasActiveLink(patientId, linkType) {
      return exists(linkDocPath(patientId, uid(), linkType))
        && get(linkDocPath(patientId, uid(), linkType)).data.status == 'active'
        && get(linkDocPath(patientId, uid(), linkType)).data.linkedUid == uid();
    }

    // Staff members inherit access via their assigned doctor (staffOf).
    function staffOf() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffOf;
    }

    function isStaffWithLink(patientId, linkType) {
      let owner = staffOf();
      return owner is string
        && exists(linkDocPath(patientId, owner, linkType))
        && get(linkDocPath(patientId, owner, linkType)).data.status == 'active'
        && get(linkDocPath(patientId, owner, linkType)).data.linkedUid == owner;
    }

    // Org-bound doctor inherits access through the org mirror link.
    function orgIdOf() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }

    function isOrgDoctorWithLink(patientId, linkType) {
      let org = orgIdOf();
      return org is string
        && exists(linkDocPath(patientId, org, linkType))
        && get(linkDocPath(patientId, org, linkType)).data.status == 'active'
        && get(linkDocPath(patientId, org, linkType)).data.permissions.read == true;
    }

    function isOrgDoctorWithWriteLink(patientId, linkType) {
      let org = orgIdOf();
      return org is string
        && exists(linkDocPath(patientId, org, linkType))
        && get(linkDocPath(patientId, org, linkType)).data.status == 'active'
        && get(linkDocPath(patientId, org, linkType)).data.permissions.write == true;
    }

    function linkedReadAllowed(patientId) {
      return (hasActiveLink(patientId, 'doctor')
        && get(linkDocPath(patientId, uid(), 'doctor')).data.permissions.read == true)
        || (hasActiveLink(patientId, 'caregiver')
        && get(linkDocPath(patientId, uid(), 'caregiver')).data.permissions.read == true)
        || (hasActiveLink(patientId, 'family')
        && get(linkDocPath(patientId, uid(), 'family')).data.permissions.read == true)
        || isStaffWithLink(patientId, 'doctor')
        || isOrgDoctorWithLink(patientId, 'doctor');
    }

    function linkedWriteAllowed(patientId) {
      return (hasActiveLink(patientId, 'doctor')
        && get(linkDocPath(patientId, uid(), 'doctor')).data.permissions.write == true)
        || (hasActiveLink(patientId, 'caregiver')
        && get(linkDocPath(patientId, uid(), 'caregiver')).data.permissions.write == true)
        || (hasActiveLink(patientId, 'family')
        && get(linkDocPath(patientId, uid(), 'family')).data.permissions.write == true)
        || isStaffWithLink(patientId, 'doctor')
        || isOrgDoctorWithWriteLink(patientId, 'doctor');
    }

    function canReadPatient(patientId) {
      return isAdmin()
        || isPatientOwner(patientId)
        || (isSignedIn() && linkedReadAllowed(patientId));
    }

    function canWritePatient(patientId) {
      return isAdmin()
        || isPatientOwner(patientId)
        || (isSignedIn() && linkedWriteAllowed(patientId));
    }

    function validFeatureCreate(patientId) {
      return isAdmin()
        || (request.resource.data.ownerId == patientId
           && request.resource.data.keys().hasAll(['ownerId', 'createdAt', 'updatedAt']));
    }

    function validFeatureUpdate(patientId) {
      return isAdmin()
        || ((!('ownerId' in request.resource.data) || request.resource.data.ownerId == patientId)
           && request.resource.data.keys().hasAny(['updatedAt', 'clientUpdatedAt']));
    }

    function canReadFeature(patientId) {
      return canReadPatient(patientId);
    }

    function canWriteFeature(patientId) {
      return canWritePatient(patientId);
    }

    // ── Per-feature permission enforcement for doctor links ─────
    // Checks the link-level featurePermissions map for a specific feature.
    // Falls back to binary permissions.read if featurePermissions is absent
    // (backward compatibility with older link documents).
    function doctorFeatureReadAllowed(patientId, feature) {
      return hasActiveLink(patientId, 'doctor')
        && get(linkDocPath(patientId, uid(), 'doctor')).data.permissions.read == true
        && (!get(linkDocPath(patientId, uid(), 'doctor')).data.keys().hasAll(['featurePermissions'])
            || get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions[feature] in ['read', 'readWrite']);
    }

    function doctorFeatureWriteAllowed(patientId, feature) {
      return hasActiveLink(patientId, 'doctor')
        && get(linkDocPath(patientId, uid(), 'doctor')).data.permissions.write == true
        && (!get(linkDocPath(patientId, uid(), 'doctor')).data.keys().hasAll(['featurePermissions'])
            || get(linkDocPath(patientId, uid(), 'doctor')).data.featurePermissions[feature] == 'readWrite');
    }

    // Staff inherits their doctor's feature permissions.
    function staffFeatureReadAllowed(patientId, feature) {
      let owner = staffOf();
      return owner is string
        && exists(linkDocPath(patientId, owner, 'doctor'))
        && get(linkDocPath(patientId, owner, 'doctor')).data.status == 'active'
        && get(linkDocPath(patientId, owner, 'doctor')).data.permissions.read == true
        && (!get(linkDocPath(patientId, owner, 'doctor')).data.keys().hasAll(['featurePermissions'])
            || get(linkDocPath(patientId, owner, 'doctor')).data.featurePermissions[feature] in ['read', 'readWrite']);
    }

    function staffFeatureWriteAllowed(patientId, feature) {
      let owner = staffOf();
      return owner is string
        && exists(linkDocPath(patientId, owner, 'doctor'))
        && get(linkDocPath(patientId, owner, 'doctor')).data.status == 'active'
        && get(linkDocPath(patientId, owner, 'doctor')).data.permissions.write == true
        && (!get(linkDocPath(patientId, owner, 'doctor')).data.keys().hasAll(['featurePermissions'])
            || get(linkDocPath(patientId, owner, 'doctor')).data.featurePermissions[feature] == 'readWrite');
    }

    // Non-doctor linked users (caregiver, family) use binary permissions.
    function nonDoctorLinkedRead(patientId) {
      return (hasActiveLink(patientId, 'caregiver')
        && get(linkDocPath(patientId, uid(), 'caregiver')).data.permissions.read == true)
        || (hasActiveLink(patientId, 'family')
        && get(linkDocPath(patientId, uid(), 'family')).data.permissions.read == true);
    }

    function nonDoctorLinkedWrite(patientId) {
      return (hasActiveLink(patientId, 'caregiver')
        && get(linkDocPath(patientId, uid(), 'caregiver')).data.permissions.write == true)
        || (hasActiveLink(patientId, 'family')
        && get(linkDocPath(patientId, uid(), 'family')).data.permissions.write == true);
    }

    function canReadSpecificFeature(patientId, feature) {
      return isAdmin()
        || isPatientOwner(patientId)
        || (isSignedIn() && doctorFeatureReadAllowed(patientId, feature))
        || (isSignedIn() && nonDoctorLinkedRead(patientId))
        || (isSignedIn() && staffFeatureReadAllowed(patientId, feature));
    }

    function canWriteSpecificFeature(patientId, feature) {
      return isAdmin()
        || isPatientOwner(patientId)
        || (isSignedIn() && doctorFeatureWriteAllowed(patientId, feature))
        || (isSignedIn() && nonDoctorLinkedWrite(patientId))
        || (isSignedIn() && staffFeatureWriteAllowed(patientId, feature));
    }

    match /users/{userId} {
      // Admin can read any user doc; users read own; linked doctors/caregivers
      // may read the patient's basic profile fields.
      // Staff can read their assigned org/doctor's user doc (staffOf).
      allow read: if isAdmin() || isSelf(userId) || linkedReadAllowed(userId)
        || (isSignedIn() && staffOf() == userId);
      // Admins can write anything.
      allow write: if isAdmin();
      // Users can update own doc but NEVER change server-controlled fields.
      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'isPro', 'disabled', 'proExpiresAt', 'proPlatform',
                     'doctorVerified', 'orgVerified']);
      // Users can create own doc (without server-controlled fields).
      allow create: if isSelf(userId)
        && !('role' in request.resource.data)
        && !('isPro' in request.resource.data)
        && !('disabled' in request.resource.data);

      // ── User: Bella AI Chats (Pro) ──────────────────────────────
      match /bellaChats/{chatId} {
        allow read, write: if isSelf(userId);

        match /messages/{messageId} {
          allow read, write: if isSelf(userId);
        }
      }

      // ── User: Private profile metadata (owner only) ───────────
      match /private/{docId} {
        allow read, write: if isSelf(userId);
      }

      // ── User: Bella Wound Analyses ──────────────────────────────
      match /bellaAnalysen/{docId} {
        allow read, write: if isSelf(userId);
      }

      // ── User: Bella AI Memory ───────────────────────────────────
      match /bella_memory/{key} {
        allow read, write: if isSelf(userId);
      }

      // ── User: Education Acknowledgments ─────────────────────────
      match /education_ack/{docId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /patients/{patientId} {
      allow read: if canReadPatient(patientId);
      allow create, update, delete: if isAdmin() || isPatientOwner(patientId);

      match /care_profile/{docId} {
        allow read: if canReadPatient(patientId);
        allow create, update, delete: if isAdmin() || isPatientOwner(patientId);
      }

      match /links/{linkId} {
        allow read: if isAdmin()
          || isPatientOwner(patientId)
          || (isSignedIn() && resource.data.linkedUid == uid())
          || (isSignedIn() && resource.data.linkedUid == staffOf())
          || (isSignedIn() && exists(/databases/$(database)/documents/organisations/$(staffOf())/doctors/$(resource.data.linkedUid)));
        // Links are managed by Cloud Functions only.
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read: if isAdmin() || isPatientOwner(patientId);
        // Invite acceptance should be handled by Cloud Functions.
        allow create: if isPatientOwner(patientId)
          && request.resource.data.status == 'pending'
          && request.resource.data.codeHash is string;
        allow update: if isPatientOwner(patientId)
          && request.resource.data.status == 'revoked';
        allow delete: if false;
      }

      // Feature subcollections
      match /timeline/{itemId} {
        allow read: if canReadSpecificFeature(patientId, 'timeline');
        allow create: if canWriteSpecificFeature(patientId, 'timeline') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'timeline') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'timeline');
      }

      match /wounds/{entryId} {
        allow read: if canReadSpecificFeature(patientId, 'wounds');
        allow create: if canWriteSpecificFeature(patientId, 'wounds') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'wounds') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'wounds');
      }

      match /pain/{entryId} {
        allow read: if canReadSpecificFeature(patientId, 'pain');
        allow create: if canWriteSpecificFeature(patientId, 'pain') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'pain') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'pain');
      }

      match /vitals/{entryId} {
        allow read: if canReadSpecificFeature(patientId, 'vitals');
        allow create: if canWriteSpecificFeature(patientId, 'vitals') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'vitals') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'vitals');
      }

      match /voice_memos/{memoId} {
        allow read: if canReadSpecificFeature(patientId, 'voice_memos');
        allow create: if canWriteSpecificFeature(patientId, 'voice_memos') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'voice_memos') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'voice_memos');
      }

      match /appointments/{appointmentId} {
        allow read: if canReadSpecificFeature(patientId, 'appointments');
        allow create: if canWriteSpecificFeature(patientId, 'appointments') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'appointments') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'appointments');
      }

      match /documents/{docId} {
        allow read: if canReadSpecificFeature(patientId, 'documents');
        allow create: if canWriteSpecificFeature(patientId, 'documents') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'documents') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'documents');
      }

      match /photos/{photoId} {
        allow read: if canReadSpecificFeature(patientId, 'documents');
        allow create: if canWriteSpecificFeature(patientId, 'documents') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'documents') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'documents');
      }

      match /packing/{itemId} {
        allow read: if canReadSpecificFeature(patientId, 'packing');
        allow create: if canWriteSpecificFeature(patientId, 'packing') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'packing') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'packing');
      }

      match /questions/{questionId} {
        allow read: if canReadSpecificFeature(patientId, 'questions');
        allow create: if canWriteSpecificFeature(patientId, 'questions') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'questions') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'questions');
      }

      // Backward compatibility for previous question path.
      match /doctor_questions/{questionId} {
        allow read: if canReadSpecificFeature(patientId, 'questions');
        allow create: if canWriteSpecificFeature(patientId, 'questions') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'questions') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'questions');
      }

      match /warnings/{checkId} {
        allow read: if canReadSpecificFeature(patientId, 'redFlags');
        allow create: if canWriteSpecificFeature(patientId, 'redFlags') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'redFlags') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'redFlags');
      }

      match /red_flags/{flagId} {
        allow read: if canReadSpecificFeature(patientId, 'redFlags');
        allow create: if canWriteSpecificFeature(patientId, 'redFlags') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'redFlags') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'redFlags');
      }

      match /symptom_checks/{checkId} {
        allow read: if canReadSpecificFeature(patientId, 'symptom_checks');
        allow create: if canWriteSpecificFeature(patientId, 'symptom_checks') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'symptom_checks') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'symptom_checks');
      }

      match /observations/{observationId} {
        allow read: if canReadSpecificFeature(patientId, 'observations');
        allow create: if canWriteSpecificFeature(patientId, 'observations') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'observations') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'observations');
      }

      match /nutrition/{entryId} {
        allow read: if canReadSpecificFeature(patientId, 'nutrition');
        allow create: if canWriteSpecificFeature(patientId, 'nutrition') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'nutrition') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'nutrition');
      }

      match /medication_intakes/{entryId} {
        allow read: if canReadSpecificFeature(patientId, 'medications');
        allow create: if canWriteSpecificFeature(patientId, 'medications') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'medications') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'medications');
      }

      match /medication_reminders/{reminderId} {
        allow read: if canReadSpecificFeature(patientId, 'medications');
        allow create: if canWriteSpecificFeature(patientId, 'medications') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'medications') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'medications');
      }

      match /mood_entries/{entryId} {
        allow read: if canReadSpecificFeature(patientId, 'mood');
        allow create: if canWriteSpecificFeature(patientId, 'mood') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'mood') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'mood');
      }

      match /sleep_entries/{entryId} {
        allow read: if canReadSpecificFeature(patientId, 'sleep');
        allow create: if canWriteSpecificFeature(patientId, 'sleep') && validFeatureCreate(patientId);
        allow update: if canWriteSpecificFeature(patientId, 'sleep') && validFeatureUpdate(patientId);
        allow delete: if canWriteSpecificFeature(patientId, 'sleep');
      }

      // ── Legacy Bella Chat (patient-only) ──────────────────────
      match /bella_chat/{msgId} {
        allow read, write: if isAdmin() || isPatientOwner(patientId);
      }

      // ── Gamification State ────────────────────────────────────
      match /gamification/{docId} {
        allow read, write: if isAdmin() || isPatientOwner(patientId);
      }

      // ── Gamification Log ──────────────────────────────────────
      match /gamification_log/{dateKey} {
        allow read, write: if isAdmin() || isPatientOwner(patientId);
      }

      // ── Daily Challenges ──────────────────────────────────────
      match /daily_challenges/{dateKey} {
        allow read, write: if isAdmin() || isPatientOwner(patientId);
      }

      // ── Recovery Feed ─────────────────────────────────────────
      match /recovery_feed/{eventId} {
        allow read, write: if isAdmin() || isPatientOwner(patientId);
      }

      // ── Patient Notifications ─────────────────────────────────
      // Notifications are created by Cloud Functions (server-side),
      // patients can only read, mark as read (update), and delete.
      match /notifications/{notifId} {
        allow read: if isAdmin() || isPatientOwner(patientId);
        allow create: if isAdmin();
        allow update: if isAdmin() || isPatientOwner(patientId);
        allow delete: if isAdmin() || isPatientOwner(patientId);
      }

      // ── Packing Lists (newer sync-based) ──────────────────────
      match /packing_lists/{listId} {
        allow read: if canReadSpecificFeature(patientId, 'packing');
        allow create: if canWriteSpecificFeature(patientId, 'packing');
        allow update: if canWriteSpecificFeature(patientId, 'packing');
        allow delete: if canWriteSpecificFeature(patientId, 'packing');

        match /items/{itemId} {
          allow read: if canReadSpecificFeature(patientId, 'packing');
          allow create: if canWriteSpecificFeature(patientId, 'packing');
          allow update: if canWriteSpecificFeature(patientId, 'packing');
          allow delete: if canWriteSpecificFeature(patientId, 'packing');
        }
      }

      // ── Supplement Reminders ──────────────────────────────────
      match /supplement_reminders/{reminderId} {
        allow read: if canReadSpecificFeature(patientId, 'medications');
        allow create: if canWriteSpecificFeature(patientId, 'medications');
        allow update: if canWriteSpecificFeature(patientId, 'medications');
        allow delete: if canWriteSpecificFeature(patientId, 'medications');
      }
    }

    // ── Doctor Templates ────────────────────────────────────────
    match /doctors/{doctorUid}/templates/{templateId} {
      allow read, write: if isAdmin() || isSelf(doctorUid);
    }

    // ── Doctor Private Notes ────────────────────────────────────
    match /doctors/{doctorUid}/patientNotes/{noteId} {
      allow read, write: if isAdmin() || isSelf(doctorUid);
    }

    // ── Doctor Workspace Root Doc ───────────────────────────────
    match /doctors/{doctorUid} {
      allow read: if isAdmin() || isSelf(doctorUid);
      allow write: if isAdmin() || isSelf(doctorUid);
    }

    // ── Doctor Staff ────────────────────────────────────────────
    match /doctors/{doctorUid}/staff/{staffId} {
      allow read, write: if isAdmin() || isSelf(doctorUid);
    }

    // ── Doctor Events ───────────────────────────────────────────
    match /doctors/{doctorUid}/events/{eventId} {
      allow read, write: if isAdmin() || isSelf(doctorUid);
    }

    // ── Doctor Notifications ────────────────────────────────────
    match /doctors/{doctorUid}/notifications/{notifId} {
      allow read: if isAdmin() || isSelf(doctorUid);
      allow create: if isAdmin(); // Created by Cloud Functions
      allow update: if isAdmin() || isSelf(doctorUid); // Doctor marks as read
      allow delete: if isAdmin() || isSelf(doctorUid);
    }

    // ── App Config: encryption key backup ──────────────────────
    match /appConfig/encryption {
      // Only admin and Cloud Functions (admin SDK) can access the
      // encryption key backup. Clients use the getEncryptionKey
      // Cloud Function for key provisioning.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    // ── App Config: global settings ─────────────────────────────
    match /appConfig/global {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Ad Configuration ────────────────────────────────────────
    match /adConfig/global {
      allow read: if isSignedIn(); // All users read ad config
      allow write: if isAdmin();
    }

    // ── Partner Ads ─────────────────────────────────────────────
    match /partnerAds/{adId} {
      allow read: if isSignedIn(); // All users read active ads
      allow write: if isAdmin();
    }

    // ── Legal Texts (privacy, terms, imprint) ───────────────────
    // DSGVO Art. 13 requires the privacy notice to be accessible before registration.
    match /legal/{type} {
      allow read: if true; // Public — no login required
      allow write: if false; // Seeded by admin script (Admin SDK)
    }

    // ── Support Tickets ─────────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == uid());
      allow create: if isSignedIn()
        && request.resource.data.userId == uid();
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == uid());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == uid());
        allow create: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == uid());
        allow update, delete: if false; // Messages are immutable
      }
    }

    // ── Aftercare: System Templates (admin-managed) ─────────────
    match /system_aftercare_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Aftercare: Organisation Templates ───────────────────────
    match /organization_aftercare_templates/{templateId} {
      // Org owner, org members (doctors with matching orgId), and their staff
      // can read. Only org owner and admin can write.
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.organizationId is string
            && (isSelf(resource.data.organizationId)
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.organizationId
                || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff'
                    && get(/databases/$(database)/documents/users/$(staffOf())).data.orgId == resource.data.organizationId)));
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.organizationId is string
            && (isSelf(request.resource.data.organizationId)
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == request.resource.data.organizationId));
      allow update, delete: if isAdmin()
        || (isSignedIn()
            && resource.data.organizationId is string
            && (isSelf(resource.data.organizationId)
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.organizationId));
    }

    // ── Aftercare: Doctor Templates ─────────────────────────────
    match /doctor_aftercare_templates/{templateId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.createdBy == uid())
        || (isSignedIn() && staffOf() is string && resource.data.createdBy == staffOf());
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.createdBy == uid())
        || (isSignedIn() && staffOf() is string && request.resource.data.createdBy == staffOf());
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.createdBy == uid())
        || (isSignedIn() && staffOf() is string && resource.data.createdBy == staffOf());
    }

    // ── Aftercare: Patient Plans ────────────────────────────────
    match /patient_aftercare_plans/{planId} {
      // Patient owner, assigned doctor, linked doctors/caregivers, and admin.
      // Staff/org-staff: staffOf() matches the plan's doctorId (covers both
      // direct-staff whose staffOf is a doctor UID and org-staff whose staffOf
      // is the organisation UID).
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.patientId == uid())
        || (isSignedIn() && resource.data.doctorId == uid())
        || (isSignedIn() && resource.data.doctorId is string
            && staffOf() == resource.data.doctorId)
        || (isSignedIn() && resource.data.patientId is string
            && linkedReadAllowed(resource.data.patientId))
        || (isSignedIn() && resource.data.patientId is string
            && isStaffWithLink(resource.data.patientId, 'doctor'));
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.doctorId == uid())
        || (isSignedIn() && request.resource.data.doctorId is string
            && staffOf() == request.resource.data.doctorId)
        || (isSignedIn() && request.resource.data.patientId is string
            && linkedWriteAllowed(request.resource.data.patientId));
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.doctorId == uid())
        || (isSignedIn() && resource.data.doctorId is string
            && staffOf() == resource.data.doctorId)
        || (isSignedIn() && resource.data.patientId is string
            && linkedWriteAllowed(resource.data.patientId));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.doctorId == uid());

      // ── Patient item progress (patient-only) ──────────────────
      // Tracks which plan items the patient has completed.
      // Only the owning patient can read and write.
      match /progress/{docId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/patient_aftercare_plans/$(planId)).data.patientId == uid();
        allow create: if isSignedIn()
          && request.resource.data.patientId == uid();
        allow update: if isSignedIn()
          && resource.data.patientId == uid();
      }

      // ── Patient private notes (strictly patient-only) ─────────
      // Private notes visible ONLY to the patient.
      // No admin, doctor, staff, or organisation access.
      match /patient_notes/{noteId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/patient_aftercare_plans/$(planId)).data.patientId == uid();
        allow create: if isSignedIn()
          && request.resource.data.patientId == uid();
        allow update, delete: if isSignedIn()
          && resource.data.patientId == uid();
      }

      // ── Plan change log (immutable audit trail) ───────────────
      // Readable by patient, doctor, and admin.
      // Writable only by doctor and admin. Never deletable.
      match /change_log/{logId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/patient_aftercare_plans/$(planId)).data.patientId == uid()
              || get(/databases/$(database)/documents/patient_aftercare_plans/$(planId)).data.doctorId == uid()
              || isAdmin());
        allow create: if isSignedIn()
          && (get(/databases/$(database)/documents/patient_aftercare_plans/$(planId)).data.doctorId == uid()
              || isAdmin());
        allow update, delete: if false;
      }
    }

    // ── Organisation Root Doc ───────────────────────────────────
    match /organisations/{orgId} {
      // Members (doctors with orgId, staff of such doctors) may read.
      allow read: if isAdmin() || isSelf(orgId)
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId)
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff'
            && get(/databases/$(database)/documents/users/$(staffOf())).data.orgId == orgId);
      allow write: if isAdmin() || isSelf(orgId);
    }

    // ── Organisation Staff ──────────────────────────────────────
    match /organisations/{orgId}/staff/{staffId} {
      allow read: if isAdmin() || isSelf(orgId)
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId);
      allow write: if isAdmin() || isSelf(orgId);
    }

    // ── Organisation Doctors ────────────────────────────────────
    match /organisations/{orgId}/doctors/{doctorId} {
      allow read: if isAdmin() || isSelf(orgId)
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffOf == orgId);
      allow write: if isAdmin() || isSelf(orgId);
    }

    // ── Organisation Invoices ───────────────────────────────────
    match /organisations/{orgId}/invoices/{invoiceId} {
      allow read: if isAdmin() || isSelf(orgId);
      allow write: if false; // managed by backend/billing system
    }

    // ── Doctor Invites (CF-managed, doctors read own) ───────────
    match /doctor_invites/{code} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.doctorUid == uid());
      allow write: if false;
    }

    // ── Doctor Permanent Codes (CF-managed) ─────────────────────
    match /doctor_permanent_codes/{code} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.doctorUid == uid());
      allow write: if false;
    }

    // ── Doctor Verifications (admin only) ───────────────────────
    match /doctor_verifications/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Organisation Invite Codes ───────────────────────────────
    match /org_invite_codes/{code} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.orgUid == uid());
      allow write: if false;
    }

    // ── Organisation Join Requests ──────────────────────────────
    match /org_join_requests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.orgUid == uid())
        || (isSignedIn() && resource.data.doctorUid == uid());
      allow write: if false;
    }

    // ── Organisation Verification Requests ──────────────────────
    match /org_verifications/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && isSelf(docId)); // org reads own verification
      allow write: if false; // managed by Cloud Functions
    }

    // ── Admin Collections ───────────────────────────────────────────
    match /adminKeys/{keyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminStats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminNotifications/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_notifications/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Internal: Push Tokens (CF-managed) ─────────────────────
    match /user_push_tokens/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow write: if false; // managed by Cloud Functions only
    }

    // ── Internal: Rate Limits (CF-managed, deny all clients) ───
    match /internal_rate_limits/{limitId} {
      allow read, write: if false; // managed by Cloud Functions only
    }

    // ── Internal: Assistant Usage (CF-managed) ──────────────────
    match /assistant_usage/{docId} {
      allow read: if isAdmin();
      allow write: if false; // managed by Cloud Functions only
    }

    // ── CollectionGroup query support ───────────────────────────
    // Required for doctors to query all their linked patients via
    // collectionGroup('links').where('linkedUid', '==', uid).
    // Staff members (role=staff) query with their assigned doctor UID
    // (staffOf) via overrideDoctorUid, so we also allow reads when
    // linkedUid matches the caller's staffOf field.
    // Org-staff (staffOf=orgUID) can read links for any doctor in the org.
    match /{path=**}/links/{linkId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.linkedUid == uid())
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffOf == resource.data.linkedUid)
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organisation'
            && exists(/databases/$(database)/documents/organisations/$(request.auth.uid)/doctors/$(resource.data.linkedUid)))
        || (isSignedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffOf is string
            && get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffOf)).data.role == 'organisation'
            && exists(/databases/$(database)/documents/organisations/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffOf)/doctors/$(resource.data.linkedUid)));
    }
  }
}
